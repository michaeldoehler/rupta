# Configuration for `docker compose up`. Copy to .env and fill in, or run
# scripts/generate-env.sh to create a .env with fresh random secrets.
# Every RUPTA_* variable is documented in docs/configuration.md and can be
# set here; empty or missing variables take their defaults.

# Version of the image to run.
RUPTA_VERSION=0.1.1
# Host port and the URL users and SDKs reach rupta under (DSNs, SSO
# redirects and links in notifications are built from it).
RUPTA_PORT=8080
RUPTA_PUBLIC_URL=http://localhost:8080

# Required. At least 32 characters: openssl rand -hex 32
RUPTA_SECRET_KEY=

# First administrator, created when the database has no users yet.
# Leave empty to create it in the setup screen instead.
RUPTA_ADMIN_EMAIL=
RUPTA_ADMIN_PASSWORD=

# Durable storage in the bundled Garage. The key id is GK followed by 24
# hex digits, the secret 64 hex digits:
#   echo GK$(openssl rand -hex 12); openssl rand -hex 32
RUPTA_BUCKET=rupta
RUPTA_S3_ACCESS_KEY_ID=
RUPTA_S3_SECRET_ACCESS_KEY=
# sync: a commit waits for the upload (nothing acknowledged is lost with
# the machine); async: upload once a second.
RUPTA_REMOTE_SYNC=sync

# Garage's own secrets: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Single sign-on with Zitadel or any OpenID Connect provider (optional).
# Redirect URI to register: ${RUPTA_PUBLIC_URL}/auth/sso/oidc/callback
RUPTA_OIDC_ISSUER=
RUPTA_OIDC_CLIENT_ID=
RUPTA_OIDC_CLIENT_SECRET=
RUPTA_OIDC_NAME=Zitadel
# Zitadel project role -> rupta role (owner, admin, member, viewer)
RUPTA_OIDC_ROLE_MAPPING=rupta-owner:owner,rupta-admin:admin,rupta-member:member,rupta-viewer:viewer

# Email for invitations and alerts (optional), e.g.
# smtps://user:password@smtp.example.com:465
RUPTA_SMTP_URL=
RUPTA_SMTP_FROM="rupta <rupta@example.com>"

# Monitoring overlay (compose.monitoring.yaml, optional): the token
# Prometheus scrapes /metrics with, Grafana's admin password, and an API
# token of rupta (scope org:read) for annotations in Grafana.
RUPTA_METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
RUPTA_GRAFANA_TOKEN=

# Days events are kept (per-project settings can lower it).
RUPTA_RETENTION_DAYS=90
RUPTA_LOG=info
