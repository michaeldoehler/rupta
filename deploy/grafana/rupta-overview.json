          "expr": "histogram_quantile(0.95, sum by (le) (rate(rupta_http_request_duration_seconds_bucket{route!~\"unmatched|/api/v1/orgs/\\\\{org\\\\}/logs/stream\",instance=~\"$instance\"}[$__rate_interval])))",
