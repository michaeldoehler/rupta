            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (status) (rupta_issues{instance=~\"$instance\"})",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest queue",
      "description": "Envelopes waiting for a worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "id": 13,
      "fieldConfig": {
        "defaults": {
