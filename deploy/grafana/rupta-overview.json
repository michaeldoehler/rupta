          "refId": "A",
          "expr": "sum by (org, project) (increase(rupta_project_new_issues_total{instance=~\"$instance\"}[$__rate_interval])) > 0",
          "legendFormat": "{{org}}/{{project}}",
          "range": true
        }
      ]
    },
