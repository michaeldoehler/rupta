          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rupta_ingest_batch_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
